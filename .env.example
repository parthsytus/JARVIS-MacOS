# Copy this to .env and fill in your keys
# Required for web search (free at https://serper.dev — 2500 queries/month)
SERPER_API_KEY=your_serper_api_key_here

# Optional: Groq cloud fallback (free tier at https://console.groq.com)
# Used only when Ollama is unavailable (3s timeout → auto-fallback)
GROQ_API_KEY=your_groq_api_key_here

# Optional: Spotify control
# Create app at https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=your_spotify_client_id
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback